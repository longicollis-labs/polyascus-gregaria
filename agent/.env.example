# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# X / Twitter v2 API (OAuth1.0a user context, for posting)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Charybdis (the host) — hot signer.
# base58 secret key (Solana, e.g. from `solana-keygen`/Phantom export) or a JSON
# byte array like [12,34,...]. This wallet is the pump.fun creator AND the
# program's host. Fund it with a little SOL for fees.
HOST_PRIVATE_KEY=

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
POLYASCUS_PROGRAM_ID=6GtAKbjHW5fdBPfZYd2zt5FvFk7fPDUhezScV9BFN1qE
PUMP_MINT=                 # the pump.fun token mint (larval phase); empty until launch

# Behavior
ACTION_CAP_SOL=1000        # safety cap on any single claim/feed
DRY_RUN=0                  # 1 = skip on-chain actions and X posts; log only

# Sim / test
MOCK_X=0                   # 1 = write posts to MOCK_X_PATH instead of X
MOCK_X_PATH=               # JSONL path; default /tmp/charybdis-mock-posts.jsonl
LOG_PATH=                  # override charybdis-log.json location
